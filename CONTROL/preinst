#!/bin/sh
echo "Checking the Enigma2 plugin path..."
LIB_PLUGINS="/usr/lib/enigma2/python/Plugins"
LIB64_PLUGINS="/usr/lib64/enigma2/python/Plugins"
LIB64_MARKER="/tmp/scsearch-use-lib64"

rm -f "$LIB64_MARKER"
if [ -d "$LIB64_PLUGINS" ] && [ ! -d "$LIB_PLUGINS" ]; then
    touch "$LIB64_MARKER"
fi
echo "***********************************"
echo "* Proceeding to installation...   *"
echo "***********************************"
exit 0
